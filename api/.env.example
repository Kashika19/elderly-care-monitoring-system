# --- Retention ---
MAX_READINGS=2000
MAX_ALERTS=500

# --- (optional) Twilio for SMS ---
TWILIO_ACCT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
ALERT_SMS_TO=
