# --- API meta ---
API_TITLE=ElderCare Monitoring API
API_VERSION=0.3.0
DATABASE_URL=sqlite:///./eldercare.db

# --- Ingest token (optional; leave empty to disable auth) ---
INGEST_TOKEN=

# --- Thresholds 
HR_WARN=120
SPO2_CRIT=92
